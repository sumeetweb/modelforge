{
  "name": "modelforge", "private": true,
  "workspaces": ["services/model-gateway", "infra/cdk"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "prettier --check 'services/model-gateway/**/*.ts' 'infra/cdk/**/*.ts' && npm run build",
    "format": "prettier --write 'services/model-gateway/**/*.ts' 'infra/cdk/**/*.ts'"
  },
  "engines": {"node": ">=22 <25"},
  "devDependencies": {"@types/node": "^26.6.5", "typescript": "~5.9.2", "vitest": "^4.0.0", "prettier": "^3.6.2"}
}
