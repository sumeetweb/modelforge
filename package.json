{
  "name": "modelforge",
  "private": true,
  "workspaces": [
    "services/console",
    "services/model-gateway",
    "infra/cdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "prettier --check 'services/model-gateway/**/*.ts' 'services/console/**/*.{ts,css,html}' 'infra/cdk/**/*.ts' && npm run build",
    "format": "prettier --write 'services/model-gateway/**/*.ts' 'services/console/**/*.{ts,css,html}' 'infra/cdk/**/*.ts'"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0",
    "prettier": "^3.6.2"
  }
}
