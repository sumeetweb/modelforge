# Copy only if you want shell overrides. make uses model-artifacts/routing.env.
MODEL_STABLE_VERSION=v1
MODEL_CANDIDATE_VERSION=v2
CANARY_PERCENT=20
UPSTREAM_TIMEOUT_MS=500
UPSTREAM_RETRIES=0
# Fault injection is disabled by default; incident tests enable it only in isolated processes.
ENABLE_FAULTS=false

# Optional in host mode; Compose and CDK configure this automatically.
# PROMETHEUS_URL=http://127.0.0.1:9090
